{
  "tests": [
    {
      "name": "Generate prompt from YouTube URL",
      "method": "POST",
      "path": "/",
      "body": {
        "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "style": "string",
        "structure": "string",
        "notes": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Empty URL returns 400",
      "method": "POST",
      "path": "/",
      "body": {
        "url": ""
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Invalid URL returns 400",
      "method": "POST",
      "path": "/",
      "body": {
        "url": "not-a-url"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}